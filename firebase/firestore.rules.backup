rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userRef(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isMemberFromUsersRef(usersRef) {
      return isSignedIn() && (userRef(request.auth.uid) in usersRef);
    }

    function isChatMember(chatId) {
      return isSignedIn() &&
          isMemberFromUsersRef(
            get(/databases/$(database)/documents/chats/$(chatId)).data.users_ref
          );
    }

    function isBookingServiceProvider(bookingServiceRef) {
      return request.auth != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.service == bookingServiceRef;
    }

    match /users/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == document;
      allow delete: if request.auth != null && request.auth.uid == document;
    }

    match /services/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /chats/{chatId} {
      allow create: if isSignedIn() &&
          (userRef(request.auth.uid) in request.resource.data.users_ref);
      allow read: if isMemberFromUsersRef(resource.data.users_ref);
      allow update: if isMemberFromUsersRef(resource.data.users_ref) &&
          request.resource.data.users_ref == resource.data.users_ref &&
          request.resource.data.start_date == resource.data.start_date;
      allow delete: if false;
    }

    match /chats/{chatId}/chat_messages/{messageId} {
      allow create: if isChatMember(chatId) &&
          request.resource.data.sender == userRef(request.auth.uid);
      allow read: if isChatMember(chatId);
      allow update: if isChatMember(chatId);
      allow delete: if false;
    }

    match /{path=**}/chat_messages/{document} {
      allow read: if false;
    }


    match /support/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /support/{parent}/support_messages/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/support_messages/{document} {
      allow read: if request.auth != null;
    }


    match /users/{parent}/my_bookings/{document} {
      allow create: if isSignedIn() && request.auth.uid == parent;
      allow read: if isSignedIn() && request.auth.uid == parent;
      allow update: if isSignedIn() && request.auth.uid == parent;
      allow delete: if false;
    }

    match /{path=**}/my_bookings/{document} {
      // Allow users to read their own bookings, 
      // or service providers to read bookings for their service
      allow read: if isSignedIn();

      // Allow booking owner (customer) to update their booking,
      // OR service provider to update if their service matches booking's service
      allow update: if isSignedIn() && 
        (resource.data.user == userRef(request.auth.uid) ||
         isBookingServiceProvider(resource.data.service));
    }


    match /users/{parent}/payment_methods/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/payment_methods/{document} {
      allow read: if request.auth != null;
    }


    match /users/{parent}/notifications/{document} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && request.auth.uid == parent;
      allow update: if isSignedIn() && request.auth.uid == parent;
      allow delete: if isSignedIn() && request.auth.uid == parent;
    }

    match /{path=**}/notifications/{document} {
      allow read: if request.auth != null;
    }


    match /calls/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /report/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /categories/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /users/{parent}/addresses/{document} {
      allow create: if request.auth != null && request.auth.uid == parent;
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == parent;
      allow delete: if request.auth != null && request.auth.uid == parent;
    }

    match /{path=**}/addresses/{document} {
      allow read: if request.auth != null;
    }


    match /users/{parent}/user_reviews/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/user_reviews/{document} {
      allow read: if request.auth != null;
    }


    match /services/{parent}/service_review/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/service_review/{document} {
      allow read: if request.auth != null;
    }


    match /users/{parent}/feedback/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/feedback/{document} {
      allow read: if request.auth != null;
    }


    match /services/{parent}/service_address/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/service_address/{document} {
      allow read: if request.auth != null;
    }


    match /services/{parent}/service_payment/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/service_payment/{document} {
      allow read: if request.auth != null;
    }

  }
}
