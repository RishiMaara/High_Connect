rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow any authenticated user to read any file
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Stricter rule for user profile uploads - user can only write to their own folder
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth.uid == userId;
    }
  }
}